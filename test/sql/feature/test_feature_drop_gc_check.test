# name: test/sql/feature/test_feature_drop_gc_check.test
# description: Verify DROP FEATURE removes the backing table and GC drops versions beyond RETAIN
# group: [feature]

require noforcestorage

require skip_reload

statement ok
CREATE TABLE events (
    customer VARCHAR,
    value INTEGER,
    event_time TIMESTAMP
);

statement ok
INSERT INTO events VALUES
    ('x', 10, '2024-01-01 08:00:00'),
    ('x', 20, '2024-01-02 08:00:00'),
    ('y', 30, '2024-01-01 12:00:00');

# ============================================================
# RETAIN 2: GC should keep only the latest 2 versions
# ============================================================
statement ok
CREATE FEATURE f ON events
    ENTITY customer
    TIMESTAMP event_time
    GRANULARITY DAY
    WINDOW 7
    REFRESH FULL
    RETAIN 2
    AS (SELECT customer, SUM(value) AS total_value);

# After create: only v1 rows
query I
SELECT COUNT(DISTINCT __feature_version) FROM f;
----
1

# refresh -> v2 ; both v1 and v2 present
statement ok
REFRESH FEATURE f;

query I
SELECT COUNT(DISTINCT __feature_version) FROM f;
----
2

# refresh -> v3 ; GC drops v1, keep v2 and v3
statement ok
REFRESH FEATURE f;

query I
SELECT COUNT(DISTINCT __feature_version) FROM f;
----
2

query I
SELECT DISTINCT __feature_version FROM f ORDER BY __feature_version;
----
2
3

# refresh -> v4 ; GC drops v2, keep v3 and v4
statement ok
REFRESH FEATURE f;

query I
SELECT DISTINCT __feature_version FROM f ORDER BY __feature_version;
----
3
4

# ============================================================
# DROP FEATURE: the remaining backing table must be gone (no leak)
# ============================================================
statement ok
DROP FEATURE f;

# No backing table left at all
query I
SELECT COUNT(*) FROM duckdb_tables WHERE table_name = 'f';
----
0

# The feature itself is gone
query I
SELECT COUNT(*) FROM duckdb_features() WHERE feature_name = 'f';
----
0

statement ok
DROP TABLE events;
